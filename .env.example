# ==============================================================================
# ALMOSTHACK — MONOREPO ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# In staging/production, inject these variables via secure secret management.
# NEVER commit real production secrets into version control.

# ==============================================================================
# 1. DATABASE CONFIGURATION (DATABASE)
# ==============================================================================
DATABASE_URL="postgresql://almosthack:almosthack_secret_password@localhost:5432/almosthack_db?schema=public"
POSTGRES_USER="almosthack"
POSTGRES_PASSWORD="almosthack_secret_password"
POSTGRES_DB="almosthack_db"
POSTGRES_PORT=5432

# ==============================================================================
# 2. REDIS / QUEUE CONFIGURATION (REDIS)
# ==============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ==============================================================================
# 3. SERVER CONFIGURATION (SERVER)
# ==============================================================================
NODE_ENV="development"
PORT=4000
API_PORT=4000
WEB_PORT=3000
API_PREFIX="api/v1"
CORS_ORIGIN="http://localhost:3000"

# ==============================================================================
# 4. AUTHENTICATION & SECRETS (AUTH / SECRET)
# ==============================================================================
# Production requires minimum 16 characters for cryptographic signing
JWT_SECRET="dev_insecure_jwt_secret_must_be_changed_in_prod"
SESSION_SECRET="dev_insecure_session_secret_must_be_changed_in_prod"

# ==============================================================================
# 5. PUBLIC CLIENT VARIABLES (PUBLIC)
# ==============================================================================
# WARNING: NEXT_PUBLIC_* variables are exposed in browser client bundles.
# NEVER place secret tokens, private keys, or passwords here.
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# 6. OBSERVABILITY & TELEMETRY (OBSERVABILITY)
# ==============================================================================
LOG_LEVEL="info"
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ==============================================================================
# 7. THIRD PARTY INTEGRATIONS (THIRD_PARTY)
# ==============================================================================
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
