# ==============================================================================
# ALMOSTHACK API — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# DATABASE
DATABASE_URL="postgresql://almosthack:almosthack_secret_password@localhost:5432/almosthack_db?schema=public"

# REDIS
REDIS_URL="redis://localhost:6379"

# SERVER
NODE_ENV="development"
PORT=4000
API_PREFIX="api/v1"
CORS_ORIGIN="http://localhost:3000"

# AUTH / SECRET
JWT_SECRET="dev_insecure_jwt_secret_must_be_changed_in_prod"
SESSION_SECRET="dev_insecure_session_secret_must_be_changed_in_prod"

# OBSERVABILITY
LOG_LEVEL="info"
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# BUILD METADATA (Optional in dev, injected during CI/CD)
GIT_COMMIT_SHA=""
APP_VERSION="1.0.0"
BUILD_TIMESTAMP=""

# THIRD PARTY (Optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
