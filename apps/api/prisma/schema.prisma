datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  ADMIN
  ORGANIZER
  JUDGE
  PARTICIPANT
  MENTOR
  SPONSOR
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  name           String
  passwordHash   String?
  avatarUrl      String?
  bio            String?
  college        String?
  branch         String?
  graduationYear Int?
  skills         String[]   @default([])
  githubUsername String?
  linkedinUrl    String?
  portfolioUrl   String?
  isVerified     Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  userRoles      UserRole[]
  auditLogs      AuditLog[]
  orgMemberships OrganizationMember[]
  notifications  Notification[]
  sessions       Session[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("sessions")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationMemberStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    OrganizationMember[]
  hackathons Hackathon[]

  @@map("organizations")
}

enum HackathonStatus {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  ARCHIVED
}

enum HackathonVisibility {
  PRIVATE
  PUBLIC
}

model Hackathon {
  id                   String              @id @default(uuid())
  organizationId       String
  name                 String
  slug                 String
  description          String?
  logoUrl              String?
  websiteUrl           String?
  timezone             String              @default("UTC")
  status               HackathonStatus     @default(DRAFT)
  visibility           HackathonVisibility @default(PRIVATE)
  registrationStartsAt DateTime
  registrationEndsAt   DateTime
  startsAt             DateTime
  endsAt               DateTime
  publishedAt          DateTime?
  completedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@map("hackathons")
}


model OrganizationMember {
  id             String                   @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole         @default(MEMBER)
  status         OrganizationMemberStatus @default(ACTIVE)
  joinedAt       DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actorEmail   String
  action       String   // e.g., 'hackathon.created', 'judging.score_submitted'
  targetEntity String   // e.g., 'Hackathon', 'Submission'
  targetId     String
  metadata     Json
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}
