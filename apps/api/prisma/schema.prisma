datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  ADMIN
  ORGANIZER
  JUDGE
  PARTICIPANT
  MENTOR
  SPONSOR
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  name           String
  passwordHash   String?
  avatarUrl      String?
  bio            String?
  college        String?
  branch         String?
  graduationYear Int?
  skills         String[]   @default([])
  githubUsername String?
  linkedinUrl    String?
  portfolioUrl   String?
  isVerified     Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  userRoles      UserRole[]
  auditLogs      AuditLog[]
  orgMemberships OrganizationMember[]
  notifications  Notification[]
  sessions       Session[]
  registrations  ParticipantRegistration[]
  createdTeams   Team[]                    @relation("TeamCreator")
  teamMembers    TeamMember[]
  receivedTeamInvitations TeamInvitation[] @relation("TeamInvitee")
  sentTeamInvitations     TeamInvitation[] @relation("TeamInviter")
  githubAccount           GitHubAccount?
  oauthStates             OAuthState[]
  judgeAssignments        JudgeAssignment[] @relation("JudgeUser")
  assignedJudges          JudgeAssignment[] @relation("JudgeAssigner")
  judgeEvaluations        JudgeEvaluation[]
  integrityReviews        IntegrityReview[]
  approvedResultSets      ResultSet[]       @relation("ResultSetApprover")
  publishedResultSets     ResultSet[]       @relation("ResultSetPublisher")

  @@map("users")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("sessions")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationMemberStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    OrganizationMember[]
  hackathons Hackathon[]

  @@map("organizations")
}

enum HackathonStatus {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  ARCHIVED
}

enum HackathonVisibility {
  PRIVATE
  PUBLIC
}

model Hackathon {
  id                   String              @id @default(uuid())
  organizationId       String
  name                 String
  slug                 String
  description          String?
  logoUrl              String?
  websiteUrl           String?
  timezone             String              @default("UTC")
  status               HackathonStatus     @default(DRAFT)
  visibility           HackathonVisibility @default(PRIVATE)
  registrationStartsAt DateTime
  registrationEndsAt   DateTime
  startsAt             DateTime
  endsAt               DateTime
  publishedAt          DateTime?
  completedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configuration HackathonConfiguration?
  tracks        HackathonTrack[]
  registrations ParticipantRegistration[]
  teams         Team[]
  submissions   Submission[]
  judgingCriteria JudgingCriterion[]
  judgeAssignments JudgeAssignment[]
  integrityAnalyses IntegrityAnalysis[]
  resultSets      ResultSet[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@map("hackathons")
}

enum ParticipationMode {
  INDIVIDUAL
  TEAM
  BOTH
}

enum EligibilityType {
  OPEN
  STUDENTS_ONLY
  INVITE_ONLY
}

enum AIUsagePolicy {
  ALLOWED
  RESTRICTED
  PROHIBITED
}

enum PreExistingCodePolicy {
  PROHIBITED
  ALLOWED
  ALLOWED_WITH_DISCLOSURE
}

enum OpenSourcePolicy {
  ALLOWED
  ALLOWED_WITH_ATTRIBUTION
  RESTRICTED
  PROHIBITED
}

enum RepositoryPolicy {
  PLATFORM_MANAGED
  EXTERNAL_ALLOWED
}

model HackathonConfiguration {
  id                    String                @id @default(uuid())
  hackathonId           String                @unique
  participationMode     ParticipationMode     @default(BOTH)
  minTeamSize           Int?                  @default(1)
  maxTeamSize           Int?                  @default(4)
  eligibilityType       EligibilityType       @default(OPEN)
  allowedBranches       String[]              @default([])
  allowedColleges       String[]              @default([])
  graduationYearFrom    Int?
  graduationYearTo      Int?
  aiUsagePolicy         AIUsagePolicy         @default(ALLOWED)
  aiDisclosureRequired  Boolean               @default(false)
  preExistingCodePolicy PreExistingCodePolicy @default(PROHIBITED)
  openSourcePolicy      OpenSourcePolicy      @default(ALLOWED_WITH_ATTRIBUTION)
  githubRequired        Boolean               @default(true)
  repositoryPolicy      RepositoryPolicy      @default(PLATFORM_MANAGED)
  rulesMarkdown         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@map("hackathon_configurations")
}

model HackathonTrack {
  id               String               @id @default(uuid())
  hackathonId      String
  name             String
  slug             String
  shortDescription String?
  description      String?
  displayOrder     Int                  @default(0)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  hackathon        Hackathon            @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  challenges       HackathonChallenge[]
  registrations    ParticipantRegistration[]
  submissions      Submission[]
  resultEntries    ResultEntry[]

  @@unique([hackathonId, slug])
  @@index([hackathonId])
  @@index([displayOrder])
  @@map("hackathon_tracks")
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model HackathonChallenge {
  id               String          @id @default(uuid())
  trackId          String
  name             String
  slug             String
  description      String?
  problemStatement String
  requirements     String?
  constraints      String?
  expectedOutcome  String?
  resources        Json            @default("[]")
  displayOrder     Int             @default(0)
  status           ChallengeStatus @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  track            HackathonTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  registrations    ParticipantRegistration[]
  submissions      Submission[]

  @@unique([trackId, slug])
  @@index([trackId])
  @@index([status])
  @@index([displayOrder])
  @@map("hackathon_challenges")
}

enum ParticipantRegistrationStatus {
  REGISTERED
  WITHDRAWN
}

model ParticipantRegistration {
  id           String                        @id @default(uuid())
  hackathonId  String
  userId       String
  trackId      String?
  challengeId  String?
  status       ParticipantRegistrationStatus @default(REGISTERED)
  registeredAt DateTime                      @default(now())
  withdrawnAt  DateTime?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  hackathon    Hackathon                     @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  track        HackathonTrack?               @relation(fields: [trackId], references: [id], onDelete: SetNull)
  challenge    HackathonChallenge?           @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@unique([hackathonId, userId])
  @@index([hackathonId])
  @@index([userId])
  @@index([status])
  @@map("participant_registrations")
}

enum TeamStatus {
  ACTIVE
  DISSOLVED
}

enum TeamMemberRole {
  CAPTAIN
  MEMBER
}

enum TeamMemberStatus {
  ACTIVE
  LEFT
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

model Team {
  id              String       @id @default(uuid())
  hackathonId     String
  name            String
  slug            String
  description     String?
  createdByUserId String
  status          TeamStatus   @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hackathon       Hackathon    @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  createdByUser   User         @relation("TeamCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  invitations     TeamInvitation[]
  repositories    TeamRepository[]
  submissions     Submission[]
  resultEntries   ResultEntry[]

  @@unique([hackathonId, slug])
  @@index([hackathonId])
  @@index([createdByUserId])
  @@index([status])
  @@map("teams")
}

model TeamMember {
  id        String           @id @default(uuid())
  teamId    String
  userId    String
  role      TeamMemberRole   @default(MEMBER)
  status    TeamMemberStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  leftAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@map("team_members")
}

model TeamInvitation {
  id              String               @id @default(uuid())
  teamId          String
  inviteeUserId   String
  invitedByUserId String
  status          TeamInvitationStatus @default(PENDING)
  expiresAt       DateTime
  respondedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  team            Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviteeUser     User                 @relation("TeamInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)
  invitedByUser   User                 @relation("TeamInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([inviteeUserId])
  @@index([status])
  @@map("team_invitations")
}



model OrganizationMember {
  id             String                   @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole         @default(MEMBER)
  status         OrganizationMemberStatus @default(ACTIVE)
  joinedAt       DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actorEmail   String
  action       String   // e.g., 'hackathon.created', 'judging.score_submitted'
  targetEntity String   // e.g., 'Hackathon', 'Submission'
  targetId     String
  metadata     Json
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ==========================================
// S2-06: GITHUB INTEGRATION & REPOSITORIES
// ==========================================

enum RepositoryStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model GitHubAccount {
  id                   String    @id @default(uuid())
  userId               String    @unique
  githubUserId         String    @unique
  githubUsername       String
  githubAvatarUrl      String?
  accessTokenEncrypted String
  scopes               String[]  @default([])
  connectedAt          DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  revokedAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([githubUserId])
  @@map("github_accounts")
}

model OAuthState {
  id          String    @id @default(uuid())
  state       String    @unique
  userId      String
  teamId      String?
  redirectUri String?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([userId])
  @@map("oauth_states")
}

model TeamRepository {
  id                   String           @id @default(uuid())
  teamId               String
  provider             String           @default("GITHUB")
  providerRepositoryId String
  ownerLogin           String
  repositoryName       String
  repositoryFullName   String
  repositoryUrl        String
  defaultBranch        String           @default("main")
  isPrivate            Boolean          @default(false)
  status               RepositoryStatus @default(CONNECTED)
  connectedAt          DateTime         @default(now())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  disconnectedAt       DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submissions Submission[]
  integrityAnalyses IntegrityAnalysis[]

  @@unique([teamId, provider])
  @@index([teamId])
  @@index([providerRepositoryId])
  @@map("team_repositories")
}

// ==========================================
// S3: SUBMISSIONS & JUDGING DOMAIN MODELS
// ==========================================

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  FINALIZED
  WITHDRAWN
}

enum JudgeAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REVOKED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

model Submission {
  id                 String           @id @default(uuid())
  hackathonId        String
  teamId             String
  trackId            String?
  challengeId        String?
  repositoryId       String?
  title              String
  description        String?
  demoUrl            String?
  documentationUrl   String?
  commitSha          String?
  snapshotBranch     String?
  snapshotCapturedAt DateTime?
  status             SubmissionStatus @default(DRAFT)
  submittedAt        DateTime?
  finalizedAt        DateTime?
  withdrawnAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  hackathon   Hackathon           @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  team        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  track       HackathonTrack?     @relation(fields: [trackId], references: [id], onDelete: SetNull)
  challenge   HackathonChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  repository  TeamRepository?     @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  assignments JudgeAssignment[]
  evaluations JudgeEvaluation[]
  integrityAnalyses IntegrityAnalysis[]
  sourceFindings IntegrityFinding[] @relation("SourceSubmission")
  targetFindings IntegrityFinding[] @relation("TargetSubmission")
  resultEntries  ResultEntry[]

  @@unique([hackathonId, teamId])
  @@index([hackathonId])
  @@index([teamId])
  @@index([trackId])
  @@index([challengeId])
  @@index([status])
  @@map("submissions")
}

model JudgingCriterion {
  id           String   @id @default(uuid())
  hackathonId  String
  name         String
  description  String?
  weight       Float    @default(1.0)
  maxScore     Float    @default(10.0)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hackathon Hackathon         @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  scores    EvaluationScore[]

  @@index([hackathonId])
  @@index([displayOrder])
  @@map("judging_criteria")
}

model JudgeAssignment {
  id              String                @id @default(uuid())
  hackathonId     String
  submissionId    String
  judgeUserId     String
  assignedByUserId String
  status          JudgeAssignmentStatus @default(ASSIGNED)
  assignedAt      DateTime              @default(now())
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  hackathon  Hackathon        @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  submission Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judgeUser  User             @relation("JudgeUser", fields: [judgeUserId], references: [id], onDelete: Cascade)
  assignedBy User             @relation("JudgeAssigner", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  evaluation JudgeEvaluation?

  @@unique([submissionId, judgeUserId])
  @@index([hackathonId])
  @@index([judgeUserId])
  @@index([submissionId])
  @@index([status])
  @@map("judge_assignments")
}

model JudgeEvaluation {
  id              String           @id @default(uuid())
  assignmentId    String           @unique
  submissionId    String
  judgeUserId     String
  status          EvaluationStatus @default(DRAFT)
  generalFeedback String?
  totalScore      Float?
  submittedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assignment JudgeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submission Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judgeUser  User            @relation(fields: [judgeUserId], references: [id], onDelete: Cascade)
  scores     EvaluationScore[]

  @@index([submissionId])
  @@index([judgeUserId])
  @@index([status])
  @@map("judge_evaluations")
}

model EvaluationScore {
  id           String   @id @default(uuid())
  evaluationId String
  criterionId  String
  score        Float
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evaluation JudgeEvaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  JudgingCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
  @@index([evaluationId])
  @@index([criterionId])
  @@map("evaluation_scores")
}

// ==========================================
// S4: INTEGRITY, PLAGIARISM & FORENSICS
// ==========================================

enum IntegrityAnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum IntegrityFindingType {
  CODE_SIMILARITY
  FILE_OVERLAP
  STRUCTURAL_SIMILARITY
  SUSPICIOUS_COPY_PATTERN
}

enum IntegrityFindingStatus {
  OPEN
  UNDER_REVIEW
  CONFIRMED
  DISMISSED
}

enum IntegritySeverity {
  LOW
  MEDIUM
  HIGH
}

model IntegrityAnalysis {
  id                   String                  @id @default(uuid())
  hackathonId          String
  submissionId         String
  repositoryId         String?
  commitSha            String
  status               IntegrityAnalysisStatus @default(QUEUED)
  engineVersion        String                  @default("1.0.0")
  configurationVersion Int                     @default(1)
  summary              Json?
  failureReason        String?
  startedAt            DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  hackathon  Hackathon         @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  submission Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  repository TeamRepository?   @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  findings   IntegrityFinding[]

  @@index([hackathonId])
  @@index([submissionId])
  @@index([status])
  @@map("integrity_analyses")
}

model IntegrityFinding {
  id                     String                 @id @default(uuid())
  analysisId             String
  submissionId           String
  comparisonSubmissionId String
  type                   IntegrityFindingType
  severity               IntegritySeverity
  confidence             Float
  similarity             Float
  status                 IntegrityFindingStatus @default(OPEN)
  summary                String
  metadata               Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  analysis             IntegrityAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  submission           Submission         @relation("SourceSubmission", fields: [submissionId], references: [id], onDelete: Cascade)
  comparisonSubmission Submission         @relation("TargetSubmission", fields: [comparisonSubmissionId], references: [id], onDelete: Cascade)
  evidence             IntegrityEvidence[]
  reviews              IntegrityReview[]

  @@index([analysisId])
  @@index([submissionId])
  @@index([comparisonSubmissionId])
  @@index([status])
  @@index([severity])
  @@map("integrity_findings")
}

model IntegrityEvidence {
  id                 String   @id @default(uuid())
  findingId          String
  sourcePath         String
  targetPath         String
  sourceStart        Int
  sourceEnd          Int
  targetStart        Int
  targetEnd          Int
  matchedFragmentHash String?
  similarityMetric   Float?
  sourceSnippet      String?
  targetSnippet      String?
  createdAt          DateTime @default(now())

  finding IntegrityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("integrity_evidence")
}

model IntegrityReview {
  id         String                 @id @default(uuid())
  findingId  String
  reviewerId String
  fromStatus IntegrityFindingStatus
  toStatus   IntegrityFindingStatus
  reason     String
  notes      String?
  createdAt  DateTime               @default(now())

  finding  IntegrityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  reviewer User             @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@index([reviewerId])
  @@map("integrity_reviews")
}

// ==========================================
// S5: RESULTS, RANKING & COMPLETION
// ==========================================

enum ResultSetStatus {
  CALCULATED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  SUPERSEDED
}

enum ResultEligibilityStatus {
  ELIGIBLE
  INELIGIBLE
  PENDING_REVIEW
}

model ResultSet {
  id                   String           @id @default(uuid())
  hackathonId          String
  status               ResultSetStatus  @default(CALCULATED)
  calculationVersion   Int              @default(1)
  scoringConfigVersion Int              @default(1)
  tieBreakRule         String           @default("WEIGHTED_CRITERIA_THEN_CONSENSUS")
  inputFingerprint     String
  calculatedAt         DateTime         @default(now())
  approvedAt           DateTime?
  publishedAt          DateTime?
  approvedByUserId     String?
  publishedByUserId    String?
  metadata             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  hackathon            Hackathon        @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  approvedByUser       User?            @relation("ResultSetApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  publishedByUser      User?            @relation("ResultSetPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  entries              ResultEntry[]

  @@index([hackathonId])
  @@index([hackathonId, status])
  @@index([status])
  @@index([inputFingerprint])
  @@map("result_sets")
}

model ResultEntry {
  id                String                  @id @default(uuid())
  resultSetId       String
  teamId            String
  submissionId      String
  trackId           String?
  score             Float
  rank              Int
  eligibilityStatus ResultEligibilityStatus @default(ELIGIBLE)
  eligibilityReason String?
  isWinner          Boolean                 @default(false)
  awardTitle        String?
  judgeCount        Int                     @default(0)
  scoreBreakdown    Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  resultSet         ResultSet               @relation(fields: [resultSetId], references: [id], onDelete: Cascade)
  team              Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submission        Submission              @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  track             HackathonTrack?         @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@unique([resultSetId, teamId])
  @@index([resultSetId])
  @@index([resultSetId, rank])
  @@index([teamId])
  @@index([submissionId])
  @@index([trackId])
  @@map("result_entries")
}




