# PUBLIC CLIENT VARIABLES
# WARNING: All variables prefixed with NEXT_PUBLIC_ are bundled into client JavaScript.
# NEVER place private database credentials, JWT secrets, or backend tokens here.
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SERVER
PORT=3000
NODE_ENV="development"
